{
  "info": {
    "_postman_id": "1c7c679e-ffe9-4fec-b1c7-12cd6b7f4237",
    "name": "WT_Login_Token",
    "description": "This helps to login to the WatchTower and Give as a token and set the token as the globle veriable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "49532129",
    "_collection_link": "https://go.postman.co/collection/49532129-1c7c679e-ffe9-4fec-b1c7-12cd6b7f4237?source=collection_link"
  },
  "item": [
    {
      "name": "Pilot",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Extract the token from the GraphQL response",
              "let jsonData = pm.response.json();",
              "let token = jsonData.data.login.token;",
              "",
              "// Save token in the active environment (dev/prod)",
              "pm.globals.set(\"Token_Pilot\", token);",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation Login {\n    login(\n        email:\"{{login_email_pilot}}\"\n        password: \"{{login_password_pilot}}\"\n    ) {\n        ... on LoginSuccess {\n            token\n        }\n    }\n}\n",
            "variables": ""
          }
        },
        "url": {
          "raw": "{{URL}}",
          "host": [
            "{{URL}}"
          ]
        }
      },
      "response": []
    },
